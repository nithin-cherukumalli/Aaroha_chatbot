# Application / deployment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
INGESTION_RUNNER=embedded
TEMP_DIR=/tmp/ai-engineering
SESSION_SECRET=replace-with-a-32-character-minimum-random-secret

# PostgreSQL (Supabase session pooler works well on Render)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Supabase storage and authentication
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=knowledge-documents
AUTH_PROVIDER=supabase
ALLOW_PUBLIC_SIGNUP=false
SAVE_CHAT_HISTORY=false

# Vector database
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=https://YOUR_CLUSTER_ENDPOINT
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=ai_engineering
QDRANT_TIMEOUT_SECONDS=20

# Embeddings
EMBEDDING_PROVIDER=qdrant_cloud
EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Answer model. openrouter/free is development/testing only.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_INPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
LLM_FREE_ONLY=true
ALLOW_FREE_ROUTER_IN_PRODUCTION=false

# Retrieval, limits and worker
CHUNK_TARGET_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_CONTEXT_K=5
RETRIEVAL_MIN_COSINE_SCORE=0.35
MAX_CONTEXT_CHARACTERS=6000
MAX_QUERY_CHARACTERS=2000
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARACTERS=1000000
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
PROVIDER_MAX_RETRIES=2
CHAT_REQUESTS_PER_USER_PER_MINUTE=10
LOG_LEVEL=INFO

